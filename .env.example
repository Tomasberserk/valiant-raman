# ==============================================================================
# Valiant Raman / Creative Workspace - Environment Configuration Example
# ==============================================================================

# LLM & Script Generation (Google Gemini)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Script Provider Mode: 'auto' (Gemini if key set, else Semantic), 'semantic', or 'dummy'
SCRIPT_PROVIDER=auto

# Text-to-Speech (Edge-TTS Neural Voice)
# Provider: 'edge_tts' or 'dummy'
VOICE_PROVIDER=edge_tts

# Neural Voice Selection (Natural Spanish)
# Popular choices:
# - es-ES-AlvaroNeural (España, Masculino natural)
# - es-ES-ElviraNeural (España, Femenino natural)
# - es-MX-DaliaNeural (México, Femenino expresivo)
# - es-MX-JorgeNeural (México, Masculino dinámico)
# - es-AR-TomasNeural (Argentina, Masculino)
VOICE_NAME=es-ES-AlvaroNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# Visual Background Provider: 'procedural' (FFmpeg lavfi thematic palettes) or 'local' (assets/backgrounds)
VISUAL_PROVIDER=procedural

# Hardware Video Encoding
# Prefer NVIDIA NVENC hardware acceleration (auto-fallback to libx264 CPU if unavailable)
PREFER_NVENC=true

# Server Settings
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000
